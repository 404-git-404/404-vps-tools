#!/bin/sh

set -eu

LC_ALL=C
export LC_ALL

unknown() {
  printf 'YouTube: UNKNOWN\n'
  exit 0
}

command -v curl >/dev/null 2>&1 || unknown
command -v awk >/dev/null 2>&1 || unknown

marker='
__YOUTUBE_CHECK_METADATA__:'
user_agent='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'
readonly marker user_agent
response=''

if ! response=$(curl \
  -4 \
  --silent \
  --location \
  --compressed \
  --fail \
  --connect-timeout 3 \
  --max-time 6 \
  --max-redirs 5 \
  --proto '=https' \
  --proto-redir '=https' \
  --user-agent "$user_agent" \
  --header 'Accept-Language: en-US,en;q=0.9' \
  --header 'Cookie: CONSENT=YES+cb.20220301-11-p0.en+FX+700' \
  --write-out "${marker}%{http_code}|%{url_effective}|%{content_type}" \
  'https://www.youtube.com/premium' 2>/dev/null); then
  unknown
fi

if ! result=$(printf '%s' "$response" | awk '
  function last_index(text, needle, offset, found, relative) {
    offset = 1
    found = 0
    while ((relative = index(substr(text, offset), needle)) != 0) {
      found = offset + relative - 1
      offset = found + 1
    }
    return found
  }

  function valid_region(value) {
    return length(value) == 2 && value ~ /^[A-Z][A-Z]$/
  }

  function scan_regions(text, key, kind, needle, position, relative, value) {
    needle = "\"" key "\""
    position = 1
    while ((relative = index(substr(text, position), needle)) != 0) {
      position += relative - 1 + length(needle)
      while (substr(text, position, 1) ~ /^[[:space:]]$/) {
        position++
      }
      if (substr(text, position, 1) != ":") {
        continue
      }
      position++
      while (substr(text, position, 1) ~ /^[[:space:]]$/) {
        position++
      }
      if (substr(text, position, 1) != "\"") {
        continue
      }
      value = substr(text, position + 1, 2)
      if (substr(text, position + 3, 1) != "\"" || !valid_region(value)) {
        position++
        continue
      }
      if (value == "CN") {
        cn = 1
      } else if (kind == "inner" && inner_region == "") {
        inner_region = value
      } else if (kind == "content" && content_region == "") {
        content_region = value
      }
      position += 4
    }
  }

  BEGIN {
    RS = sprintf("%c", 1)
    marker = "\n__YOUTUBE_CHECK_METADATA__:"
    unknown = "YouTube: UNKNOWN"
  }

  {
    marker_at = last_index($0, marker)
    if (marker_at == 0) {
      print unknown
      next
    }

    body = substr($0, 1, marker_at - 1)
    metadata = substr($0, marker_at + length(marker))
    first_separator = index(metadata, "|")
    if (first_separator == 0) {
      print unknown
      next
    }
    http_status = substr(metadata, 1, first_separator - 1)
    metadata = substr(metadata, first_separator + 1)
    second_separator = index(metadata, "|")
    if (second_separator == 0) {
      print unknown
      next
    }
    effective_url = substr(metadata, 1, second_separator - 1)
    content_type = substr(metadata, second_separator + 1)

    if (body == "" || http_status != "200" ||
        !(effective_url == "https://www.youtube.com" ||
          index(effective_url, "https://www.youtube.com/") == 1) ||
        index(content_type, "text/html") != 1) {
      print unknown
      next
    }
    if (index(body, "<title>Before you continue to YouTube</title>") ||
        index(body, "consent.youtube.com/save")) {
      print unknown
      next
    }

    if (index(body, "www.google.cn")) {
      cn = 1
    }
    scan_regions(body, "INNERTUBE_CONTEXT_GL", "inner")
    scan_regions(body, "contentRegion", "content")

    if (cn) {
      print "YouTube: CN"
    } else if (inner_region != "") {
      print "YouTube: NOT_CN [" inner_region "]"
    } else if (content_region != "") {
      print "YouTube: NOT_CN [" content_region "]"
    } else {
      print unknown
    }
  }
'); then
  unknown
fi

[ -n "$result" ] || unknown
printf '%s\n' "$result"
